---
interface Props {
  active?: string;
}

const { active } = Astro.props;

const navItems = [
  { label: 'Ingredientes', href: '/ingredientes/', id: 'ingredientes' },
  { label: 'Rutinas', href: '/rutinas/', id: 'rutinas' },
  { label: 'Estudios', href: '/estudios/', id: 'estudios' },
  { label: 'Productos', href: '/catalogo/', id: 'productos' },
  { label: 'Diario', href: '/diario/', id: 'diario' },
];
---

<header style="border-bottom: 1px solid var(--color-divider);">
  <div style="display:flex;align-items:center;gap:26px;padding:22px 56px;max-width:1280px;margin:0 auto;">
    <a href="/" style="font-family:var(--font-heading);font-size:21px;letter-spacing:-.02em;color:var(--color-text);text-decoration:none;">
      bellza<span style="color:var(--color-accent);">y</span>piel
    </a>
    <nav style="display:flex;gap:22px;font-size:14.5px;font-weight:600;margin-left:10px;">
      {navItems.map(item => (
        <a 
          href={item.href} 
          style={active === item.id 
            ? 'color:#8c491a;border-bottom:2px solid #c67139;padding-bottom:2px;' 
            : 'color:#201e1d;text-decoration:none;'}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div style="margin-left:auto;display:flex;gap:12px;align-items:center;">
      <button type="button" aria-label="Buscar" style="width:36px;height:36px;border-radius:999px;border:1px solid var(--color-divider);background:transparent;cursor:pointer;display:grid;place-content:center;">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      </button>
      <a href="/rutina/" style="display:inline-flex;align-items:center;gap:6px;background:var(--color-accent);color:var(--color-bg);font-family:var(--font-heading);font-size:14px;padding:10px 20px;border-radius:999px;text-decoration:none;">
        Armar mi rutina
      </a>
    </div>
  </div>
</header>
