---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { categoriasDiario, getCategoria } from '../../../data/diario';

export function getStaticPaths() {
  return categoriasDiario.map((c) => ({ params: { categoria: c.slug } }));
}

const { categoria } = Astro.params;
const cat = getCategoria(categoria)!;

const title = `${cat.nombre} — Diario — Bellezaypiel`;
---

<Layout title={title} description={cat.descripcion}>
  <div style="background:var(--color-bg);min-height:100vh;">
    <Header active="diario" />

    <div style="position:relative;padding:52px 56px 0;overflow:hidden;max-width:1280px;margin:0 auto;">
      <div style="position:absolute;right:-90px;top:-120px;width:300px;height:300px;border-radius:50%;background:var(--color-accent2-200);opacity:.7;"></div>
      <div style="position:relative;display:flex;gap:8px;font-size:13.5px;color:var(--color-neutral-700);margin-bottom:20px;flex-wrap:wrap;">
        <a href="/" style="color:var(--color-neutral-700);">Inicio</a>
        <span>/</span>
        <a href="/diario/" style="color:var(--color-neutral-700);">Diario</a>
        <span>/</span>
        <span style="font-weight:600;color:var(--color-text);">{cat.nombre}</span>
      </div>
      <h1 style="position:relative;font-family:var(--font-heading);font-size:52px;line-height:1.08;letter-spacing:-.028em;margin:0;max-width:20ch;">{cat.nombre}</h1>
      <p style="position:relative;font-size:17px;line-height:1.7;color:#3a3733;margin:22px 0 0;max-width:58ch;">{cat.descripcion}</p>
    </div>

    <div style="padding:48px 56px 0;max-width:1280px;margin:0 auto;display:grid;grid-template-columns:repeat(3,1fr);gap:28px;">
      {cat.articulos.map((art) => (
        <a href={`/diario/${cat.slug}/${art.slug}/`} style="display:flex;flex-direction:column;gap:14px;color:var(--color-text);text-decoration:none;">
          <figure style="margin:0;border-radius:22px;overflow:hidden;background:var(--color-surface);aspect-ratio:3/2;display:grid;place-content:center;">
            <img src={`/images/diario/${cat.slug}/${art.slug}.svg`} alt={art.titulo} style="width:100%;height:100%;object-fit:cover;" loading="lazy" />
          </figure>
          <h3 style="font-family:var(--font-heading);font-weight:400;font-size:21px;line-height:1.25;margin:0;">{art.titulo}</h3>
          <p style="font-size:14.5px;line-height:1.6;color:#4a463f;margin:0;">{art.excerpt}</p>
          <span style="font-size:12.5px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--color-neutral-600);margin-top:auto;">{art.fecha} · {art.lectura}</span>
        </a>
      ))}
    </div>

    <div style="padding:70px 56px 64px;max-width:1280px;margin:0 auto;">
      <div style="background:var(--color-accent-100);border-radius:40px;padding:44px 48px;display:grid;grid-template-columns:1fr auto;gap:36px;align-items:center;">
        <div>
          <h3 style="font-family:var(--font-heading);font-size:27px;line-height:1.16;margin:0;">¿No sabes por dónde empezar?</h3>
          <p style="font-size:15.5px;line-height:1.65;color:#4a463f;margin:14px 0 0;max-width:50ch;">Seis preguntas sobre tu piel y te devolvemos una rutina con las fichas de cada paso.</p>
        </div>
        <a href="/rutina/" style="display:inline-flex;align-items:center;gap:6px;background:var(--color-accent);color:var(--color-bg);font-family:var(--font-heading);font-size:15px;padding:14px 28px;border-radius:999px;text-decoration:none;">Empezar el test</a>
      </div>
    </div>

    <Footer />
  </div>
</Layout>
