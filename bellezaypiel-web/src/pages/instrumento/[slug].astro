---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { coleccionesPilares, getItem } from '../../data/pilares';

export function getStaticPaths() {
  const col = coleccionesPilares.find((c) => c.slug === 'instrumento')!;
  return col.items.map((i) => ({ params: { slug: i.slug } }));
}

const { slug } = Astro.params;
const { coleccion: col, item } = getItem('instrumento', slug)!;

const tagStyle =
  item.evidencia.toLowerCase().includes('alta')
    ? 'background:var(--color-accent2-100);color:var(--color-accent2-800);'
    : item.evidencia.toLowerCase().includes('limitada')
      ? 'border:1px solid var(--color-accent);color:var(--color-accent);'
      : 'background:var(--color-accent-100);color:var(--color-accent-800);';
---

<Layout title={`${item.nombre} — ${col.nombre} — Bellezaypiel`} description={item.resumen}>
  <div style="background:var(--color-bg);min-height:100vh;">
    <Header active="productos" />

    <div style="display:grid;grid-template-columns:5fr 6fr;gap:56px;padding:44px 56px 0;max-width:1280px;margin:0 auto;">
      <figure style="margin:0;border-radius:36px;overflow:hidden;background:var(--color-surface);aspect-ratio:1/1;display:grid;place-content:center;">
        <img src={`/images/instrumento/${item.slug}.svg`} alt={item.nombre} style="width:100%;height:100%;object-fit:cover;" />
      </figure>
      <div>
        <div style="display:flex;gap:8px;font-size:13.5px;color:var(--color-neutral-700);margin-bottom:18px;flex-wrap:wrap;">
          <a href="/" style="color:var(--color-neutral-700);">Inicio</a><span>/</span>
          <a href={`/${col.slug}/`} style="color:var(--color-neutral-700);">{col.nombre}</a><span>/</span>
          <span style="font-weight:600;color:var(--color-text);">{item.nombre}</span>
        </div>
        <span style={`display:inline-flex;align-items:center;font-size:12px;letter-spacing:.02em;padding:5px 12px;border-radius:calc(var(--radius-md)*.75);${tagStyle}`}>{item.evidencia}</span>
        <h1 style="font-family:var(--font-heading);font-size:42px;line-height:1.1;letter-spacing:-.025em;margin:18px 0 0;">{item.nombre}</h1>
        <p style="font-size:17px;line-height:1.7;color:#3a3733;margin:20px 0 0;max-width:50ch;">{item.resumen}</p>
        <div style="display:flex;gap:14px;align-items:center;flex-wrap:wrap;margin-top:30px;">
          <a href="/rutina/" style="display:inline-flex;align-items:center;gap:6px;background:var(--color-accent);color:var(--color-bg);font-family:var(--font-heading);font-size:15px;padding:14px 28px;border-radius:999px;text-decoration:none;">Añadir a mi rutina</a>
        </div>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:6fr 5fr;gap:56px;padding:76px 56px 0;max-width:1280px;margin:0 auto;">
      <div>
        <h2 style="font-family:var(--font-heading);font-size:30px;letter-spacing:-.02em;margin:0 0 16px;">Qué es</h2>
        <p style="font-size:16.5px;line-height:1.8;color:#3a3733;margin:0 0 32px;max-width:60ch;">{item.queEs}</p>

        <h2 style="font-family:var(--font-heading);font-size:30px;letter-spacing:-.02em;margin:0 0 16px;">Cómo se usa</h2>
        <ol style="margin:0 0 32px;padding-left:22px;display:flex;flex-direction:column;gap:10px;font-size:16px;line-height:1.7;color:#3a3733;max-width:60ch;">
          {item.comoUsar.map((paso) => (
            <li>{paso}</li>
          ))}
        </ol>

        <h2 style="font-family:var(--font-heading);font-size:30px;letter-spacing:-.02em;margin:0 0 16px;">Frecuencia</h2>
        <p style="font-size:16.5px;line-height:1.8;color:#3a3733;margin:0;max-width:60ch;">{item.frecuencia}</p>
      </div>

      <div style="display:flex;flex-direction:column;gap:24px;">
        <div style="background:var(--color-accent2-100);border-radius:32px;padding:32px;">
          <h3 style="font-family:var(--font-heading);font-size:22px;margin:0 0 16px;">Qué puedes esperar</h3>
          <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:12px;font-size:15px;line-height:1.65;color:#3a3733;">
            {item.beneficios.map((b) => (
              <li style="display:flex;gap:12px;"><span style="width:10px;height:10px;border-radius:50%;background:var(--color-accent2-600);flex:none;margin-top:7px;"></span><span>{b}</span></li>
            ))}
          </ul>
        </div>
        <div style="background:var(--color-neutral-100);border-radius:32px;padding:32px;">
          <h3 style="font-family:var(--font-heading);font-size:22px;margin:0 0 14px;">Precauciones</h3>
          <p style="font-size:15px;line-height:1.7;color:#3a3733;margin:0;">{item.precauciones}</p>
        </div>
        <div style="background:var(--color-accent-100);border-radius:32px;padding:32px;">
          <h3 style="font-family:var(--font-heading);font-size:22px;margin:0 0 14px;">Para quién</h3>
          <p style="font-size:15px;line-height:1.7;color:#3a3733;margin:0;">{item.paraQuien}</p>
        </div>
      </div>
    </div>

    <div style="padding:76px 56px 64px;max-width:1280px;margin:0 auto;">
      <h2 style="font-family:var(--font-heading);font-size:30px;letter-spacing:-.02em;margin:0 0 26px;">Otros {col.nombre.toLowerCase()}</h2>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;">
        {col.items.filter((i) => i.slug !== slug).slice(0, 3).map((otro) => (
          <a href={`/${col.slug}/${otro.slug}/`} style="display:flex;gap:18px;align-items:center;background:var(--color-neutral-100);border-radius:24px;padding:20px;color:var(--color-text);text-decoration:none;">
            <figure style="margin:0;border-radius:16px;overflow:hidden;background:var(--color-surface);width:84px;height:84px;display:grid;place-content:center;flex:none;">
              <img src={`/images/${col.slug}/${otro.slug}.svg`} alt={otro.nombre} style="width:100%;height:100%;object-fit:cover;" loading="lazy" />
            </figure>
            <div><strong style="font-weight:600;font-size:15.5px;display:block;">{otro.nombre}</strong><span style="font-size:14px;color:var(--color-neutral-700);">{otro.resumen}</span></div>
          </a>
        ))}
      </div>
    </div>

    <Footer />
  </div>
</Layout>
