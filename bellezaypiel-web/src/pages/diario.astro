---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { categoriasDiario } from '../data/diario';

const total = categoriasDiario.reduce((acc, c) => acc + c.articulos.length, 0);
---

<Layout title="Diario — Bellezaypiel" description="Artículos largos sobre yoga facial, ejercicios, rutinas, masajes, cuidado facial y guías comparativas. Publicamos sin calendario forzado.">
  <div style="background:var(--color-bg);min-height:100vh;">
    <Header active="diario" />

    <div style="position:relative;padding:52px 56px 0;overflow:hidden;max-width:1280px;margin:0 auto;">
      <div style="position:absolute;right:-90px;top:-120px;width:300px;height:300px;border-radius:50%;background:var(--color-accent2-200);opacity:.7;"></div>
      <div style="position:relative;display:flex;gap:8px;font-size:13.5px;color:var(--color-neutral-700);margin-bottom:20px;">
        <a href="/" style="color:var(--color-neutral-700);">Inicio</a><span>/</span><span style="font-weight:600;color:var(--color-text);">Diario</span>
      </div>
      <h1 style="position:relative;font-family:var(--font-heading);font-size:52px;line-height:1.08;letter-spacing:-.028em;margin:0;max-width:20ch;">Diario</h1>
      <p style="position:relative;font-size:17px;line-height:1.7;color:#3a3733;margin:22px 0 0;max-width:58ch;">{total} lecturas largas organizadas por territorio: qué funciona según la evidencia, qué es ruido y cuándo la siguiente parada es un profesional.</p>
    </div>

    {categoriasDiario.map((cat) => (
      <section style="padding:56px 56px 0;max-width:1280px;margin:0 auto;">
        <div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:10px;">
          <h2 style="font-family:var(--font-heading);font-size:32px;letter-spacing:-.02em;margin:0;">{cat.nombre}</h2>
          <a href={`/diario/${cat.slug}/`} style="font-size:14.5px;font-weight:600;">Ver los {cat.articulos.length} artículos</a>
        </div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:26px;">
          {cat.articulos.slice(0, 3).map((art) => (
            <a href={`/diario/${cat.slug}/${art.slug}/`} style="display:flex;flex-direction:column;gap:12px;color:var(--color-text);text-decoration:none;">
              <figure style="margin:0;border-radius:22px;overflow:hidden;background:var(--color-surface);aspect-ratio:3/2;display:grid;place-content:center;">
                <img src={`/images/diario/${cat.slug}/${art.slug}.svg`} alt={art.titulo} style="width:100%;height:100%;object-fit:cover;" loading="lazy" />
              </figure>
              <span style="font-size:12.5px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--color-accent-700);">{cat.nombre}</span>
              <h3 style="font-family:var(--font-heading);font-weight:400;font-size:21px;line-height:1.25;margin:0;">{art.titulo}</h3>
              <p style="font-size:14.5px;line-height:1.6;color:#4a463f;margin:0;">{art.excerpt}</p>
              <span style="font-size:12.5px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--color-neutral-600);margin-top:auto;">{art.fecha} · {art.lectura}</span>
            </a>
          ))}
        </div>
      </section>
    ))}

    <div style="padding:76px 56px 64px;max-width:1280px;margin:0 auto;">
      <div style="background:var(--color-accent2-100);border-radius:44px;padding:52px 56px;display:grid;grid-template-columns:1fr auto;gap:40px;align-items:end;">
        <div>
          <h3 style="font-family:var(--font-heading);font-size:31px;line-height:1.14;letter-spacing:-.02em;margin:0;max-width:26ch;">El resumen del mes, en cinco minutos de lectura</h3>
          <p style="font-size:16px;line-height:1.65;color:var(--color-accent2-800);margin:18px 0 0;max-width:52ch;">Un correo al mes con lo que salió publicado, lo que cambia una rutina real y lo que puedes ignorar sin culpa.</p>
        </div>
        <div style="display:flex;gap:12px;align-items:stretch;width:400px;">
          <input type="email" placeholder="tu@correo.com" aria-label="Correo electrónico" style="flex:1;border-radius:999px;min-height:46px;padding:6px 14px;font:inherit;font-size:14px;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-divider);" />
          <button type="button" style="border-radius:999px;padding:0 24px;min-height:46px;background:var(--color-accent);color:var(--color-bg);font-family:var(--font-heading);font-size:14px;border:none;cursor:pointer;">Suscribirme</button>
        </div>
      </div>
    </div>

    <Footer />
  </div>
</Layout>
