---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Sérum de niacinamida 5% + zinc PCA — Bellezaypiel">
  <div style="background:var(--color-bg);min-height:100vh;">
    <Header active="productos" />
    
    <div style="display:grid;grid-template-columns:5fr 6fr;gap:56px;padding:44px 56px 0;max-width:1280px;margin:0 auto;">
      <div>
        <figure class="washed" style="margin:0;border-radius:36px;overflow:hidden;background:var(--color-surface);aspect-ratio:1/1;display:grid;place-content:center;"><span style="font-size:13px;color:var(--color-neutral-600);">Producto, plano cenital</span></figure>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:12px;">
          <figure class="washed" style="margin:0;border-radius:18px;overflow:hidden;background:var(--color-surface);aspect-ratio:1/1;display:grid;place-content:center;"><span style="font-size:11px;color:var(--color-neutral-600);">Textura</span></figure>
          <figure class="washed" style="margin:0;border-radius:18px;overflow:hidden;background:var(--color-surface);aspect-ratio:1/1;display:grid;place-content:center;"><span style="font-size:11px;color:var(--color-neutral-600);">Envase</span></figure>
          <figure class="washed" style="margin:0;border-radius:18px;overflow:hidden;background:var(--color-surface);aspect-ratio:1/1;display:grid;place-content:center;"><span style="font-size:11px;color:var(--color-neutral-600);">En uso</span></figure>
        </div>
      </div>
      <div>
        <div style="display:flex;gap:8px;font-size:13.5px;color:var(--color-neutral-700);margin-bottom:18px;">
          <a href="/catalogo/">Productos</a><span>/</span><a href="/catalogo/">Sérums</a><span>/</span><span style="font-weight:600;color:var(--color-text);">Niacinamida 5%</span>
        </div>
        <span style="display:block;font-size:13px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:var(--color-accent-700);margin-bottom:12px;">Probado 8 semanas</span>
        <h1 style="font-family:var(--font-heading);font-size:42px;line-height:1.1;letter-spacing:-.025em;margin:0;">Sérum de niacinamida 5% + zinc PCA</h1>
        <p style="font-size:17px;line-height:1.7;color:#3a3733;margin:20px 0 0;max-width:50ch;">Un sérum ligero para pieles que brillan a mediodía y se irritan con casi todo lo demás. Hace bien una cosa, y la hace por menos de veinte euros.</p>
        
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:32px;">
          <div style="background:var(--color-accent2-100);border-radius:22px;padding:20px;">
            <span style="display:block;font-size:12px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--color-accent2-700);">Evidencia</span>
            <span style="display:block;font-family:var(--font-heading);font-size:26px;color:var(--color-accent2-800);margin-top:6px;">Alta</span>
            <span style="display:block;font-size:13px;color:var(--color-accent2-700);margin-top:4px;">9 ensayos revisados</span>
          </div>
          <div style="background:var(--color-neutral-200);border-radius:22px;padding:20px;">
            <span style="display:block;font-size:12px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--color-neutral-700);">Tolerancia</span>
            <span style="display:block;font-family:var(--font-heading);font-size:26px;color:var(--color-neutral-900);margin-top:6px;">Buena</span>
            <span style="display:block;font-size:13px;color:var(--color-neutral-700);margin-top:4px;">Sin picor a diario</span>
          </div>
          <div style="background:var(--color-accent-100);border-radius:22px;padding:20px;">
            <span style="display:block;font-size:12px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--color-accent-700);">Precio por ml</span>
            <span style="display:block;font-family:var(--font-heading);font-size:26px;color:var(--color-accent-800);margin-top:6px;">0,60 €</span>
            <span style="display:block;font-size:13px;color:var(--color-accent-700);margin-top:4px;">Media del mercado: 1,10 €</span>
          </div>
        </div>
        
        <div style="display:flex;gap:14px;align-items:center;flex-wrap:wrap;margin-top:30px;">
          <a href="#" style="display:inline-flex;align-items:center;gap:6px;background:var(--color-accent);color:var(--color-bg);font-family:var(--font-heading);font-size:15px;padding:14px 28px;border-radius:999px;text-decoration:none;">Ver dónde comprarlo · 18 €</a>
          <a href="#" style="display:inline-flex;align-items:center;gap:6px;background:transparent;color:var(--color-text);font-family:var(--font-heading);font-size:15px;padding:14px 24px;border-radius:999px;text-decoration:none;border:1px solid var(--color-divider);">Añadir a mi rutina</a>
        </div>
        <p style="font-size:13px;line-height:1.6;color:var(--color-neutral-700);margin:16px 0 0;max-width:46ch;">Compramos lo que probamos. Si un enlace es de afiliado lo marcamos aquí mismo, y nunca cambia el veredicto.</p>
      </div>
    </div>
    
    <div style="display:grid;grid-template-columns:6fr 5fr;gap:56px;padding:76px 56px 0;max-width:1280px;margin:0 auto;">
      <div>
        <h2 style="font-family:var(--font-heading);font-size:30px;letter-spacing:-.02em;margin:0 0 24px;">Qué lleva y por qué</h2>
        <div style="display:flex;flex-direction:column;gap:2px;">
          <div style="display:grid;grid-template-columns:auto 1fr auto;gap:18px;align-items:baseline;padding:18px 0;border-bottom:1px solid var(--color-divider);">
            <span style="font-family:var(--font-heading);font-size:19px;color:var(--color-accent-700);width:56px;">5%</span>
            <div><strong style="font-weight:600;font-size:16px;">Niacinamida</strong><p style="font-size:14.5px;line-height:1.6;color:#4a463f;margin:4px 0 0;">Regula sebo y refuerza barrera. La concentración está dentro del rango con respaldo.</p></div>
            <span style="display:inline-flex;align-items:center;font-size:11px;letter-spacing:.02em;padding:3px 10px;border-radius:calc(var(--radius-md)*.75);background:var(--color-accent2-100);color:var(--color-accent2-800);">Activo principal</span>
          </div>
          <div style="display:grid;grid-template-columns:auto 1fr auto;gap:18px;align-items:baseline;padding:18px 0;border-bottom:1px solid var(--color-divider);">
            <span style="font-family:var(--font-heading);font-size:19px;color:var(--color-accent-700);width:56px;">1%</span>
            <div><strong style="font-weight:600;font-size:16px;">Zinc PCA</strong><p style="font-size:14.5px;line-height:1.6;color:#4a463f;margin:4px 0 0;">Ayuda con el brillo. La evidencia propia es modesta; aquí acompaña, no protagoniza.</p></div>
            <span style="display:inline-flex;align-items:center;font-size:11px;letter-spacing:.02em;padding:3px 10px;border-radius:calc(var(--radius-md)*.75);background:var(--color-accent-100);color:var(--color-accent-800);">Secundario</span>
          </div>
          <div style="display:grid;grid-template-columns:auto 1fr auto;gap:18px;align-items:baseline;padding:18px 0;border-bottom:1px solid var(--color-divider);">
            <span style="font-family:var(--font-heading);font-size:19px;color:var(--color-accent-700);width:56px;">—</span>
            <div><strong style="font-weight:600;font-size:16px;">Glicerina y pantenol</strong><p style="font-size:14.5px;line-height:1.6;color:#4a463f;margin:4px 0 0;">Humectantes que hacen la fórmula cómoda en piel reactiva.</p></div>
            <span style="display:inline-flex;align-items:center;font-size:11px;letter-spacing:.02em;padding:3px 10px;border-radius:calc(var(--radius-md)*.75);background:var(--color-neutral-100);color:var(--color-neutral-800);">Base</span>
          </div>
          <div style="display:grid;grid-template-columns:auto 1fr auto;gap:18px;align-items:baseline;padding:18px 0;">
            <span style="font-family:var(--font-heading);font-size:19px;color:var(--color-accent-700);width:56px;">0</span>
            <div><strong style="font-weight:600;font-size:16px;">Fragancia y alcohol denat.</strong><p style="font-size:14.5px;line-height:1.6;color:#4a463f;margin:4px 0 0;">No los lleva. Es la razón por la que lo recomendamos en rosácea leve.</p></div>
            <span style="display:inline-flex;align-items:center;font-size:11px;letter-spacing:.02em;padding:3px 10px;border-radius:calc(var(--radius-md)*.75);border:1px solid var(--color-accent);color:var(--color-accent);">Ausente</span>
          </div>
        </div>
        <h3 style="font-family:var(--font-heading);font-size:24px;margin:40px 0 14px;">Con qué no lo mezcles</h3>
        <p style="font-size:15.5px;line-height:1.7;color:#3a3733;margin:0;max-width:52ch;">Puedes usarlo el mismo día que un retinoide, pero en momentos distintos: retinoide de noche, este de mañana. Con exfoliantes ácidos, deja pasar un día. La incompatibilidad con vitamina C que circula por internet no se sostiene a las concentraciones de un cosmético.</p>
      </div>
      <div>
        <div style="background:var(--color-accent2-100);border-radius:32px;padding:36px 32px;">
          <span style="display:block;font-size:12.5px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--color-accent2-700);margin-bottom:16px;">La evidencia detrás</span>
          <h3 style="font-family:var(--font-heading);font-size:25px;line-height:1.18;margin:0 0 20px;">Lo que sí está medido</h3>
          <div style="display:flex;flex-direction:column;gap:20px;">
            <div style="display:flex;gap:14px;"><span style="width:11px;height:11px;border-radius:50%;background:var(--color-accent2-600);flex:none;margin-top:7px;"></span><p style="font-size:15px;line-height:1.6;margin:0;color:var(--color-neutral-900);">Reducción de pérdida transepidérmica de agua a las 4 semanas en piel seca. Ensayo controlado, muestra mediana.</p></div>
            <div style="display:flex;gap:14px;"><span style="width:11px;height:11px;border-radius:50%;background:var(--color-accent2-600);flex:none;margin-top:7px;"></span><p style="font-size:15px;line-height:1.6;margin:0;color:var(--color-neutral-900);">Menos sebo declarado a las 8 semanas frente a vehículo, en concentraciones del 2% al 5%.</p></div>
            <div style="display:flex;gap:14px;"><span style="width:11px;height:11px;border-radius:50%;background:var(--color-neutral-400);flex:none;margin-top:7px;"></span><p style="font-size:15px;line-height:1.6;margin:0;color:#4a463f;">Aclarado de manchas: resultados mixtos y lentos. Si es tu objetivo principal, hay opciones mejores.</p></div>
          </div>
          <a href="#" style="display:inline-block;margin-top:26px;font-size:14.5px;font-weight:600;color:var(--color-accent2-700);">Ver las tres fuentes citadas</a>
        </div>
        <div style="background:var(--color-neutral-100);border-radius:32px;padding:32px;margin-top:20px;">
          <span style="display:block;font-size:12.5px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--color-neutral-700);margin-bottom:14px;">Para quién sí, para quién no</span>
          <p style="font-size:15px;line-height:1.7;color:#3a3733;margin:0;">Sí: piel mixta u oleosa, brotes leves, barrera sensible.<br>No: si buscas tratar melasma o arrugas marcadas, este frasco no es el tuyo.</p>
        </div>
      </div>
    </div>
    
    <div style="display:grid;grid-template-columns:6fr 5fr;gap:56px;padding:76px 56px 0;max-width:1280px;margin:0 auto;">
      <div>
        <h2 style="font-family:var(--font-heading);font-size:30px;letter-spacing:-.02em;margin:0 0 8px;">Ingredientes</h2>
        <p style="font-size:15px;line-height:1.65;color:var(--color-neutral-700);margin:0 0 24px;max-width:52ch;">Lista INCI completa, en el orden del envase. Marcamos lo que hace trabajo y lo que solo sostiene la fórmula.</p>
        <div style="background:var(--color-neutral-100);border-radius:28px;padding:28px 30px;">
          <p style="font-size:15px;line-height:2;color:#3a3733;margin:0;">
            <strong style="font-weight:600;color:var(--color-accent-700);">Aqua</strong> · <strong style="font-weight:600;color:var(--color-accent-700);">Niacinamide</strong> · <strong style="font-weight:600;color:var(--color-accent-700);">Glycerin</strong> · Pentylene Glycol · <strong style="font-weight:600;color:var(--color-accent-700);">Zinc PCA</strong> · <strong style="font-weight:600;color:var(--color-accent-700);">Panthenol</strong> · Sodium Hyaluronate · Butylene Glycol · Tamarindus Indica Seed Gum · Xanthan Gum · Citric Acid · Sodium Citrate · Trisodium Ethylenediamine Disuccinate · Sodium Benzoate · Potassium Sorbate
          </p>
          <div style="display:flex;gap:22px;flex-wrap:wrap;margin-top:22px;padding-top:20px;border-top:1px solid var(--color-divider);font-size:13.5px;color:var(--color-neutral-700);">
            <span style="display:flex;gap:8px;align-items:center;"><span style="width:10px;height:10px;border-radius:50%;background:var(--color-accent);"></span>Hace trabajo (6)</span>
            <span style="display:flex;gap:8px;align-items:center;"><span style="width:10px;height:10px;border-radius:50%;background:var(--color-neutral-400);"></span>Base, textura y conservación (9)</span>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px;">
          <div style="background:var(--color-accent2-100);border-radius:20px;padding:18px 20px;"><span style="display:block;font-size:12px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--color-accent2-700);">Sin fragancia</span><span style="display:block;font-size:14.5px;color:var(--color-neutral-900);margin-top:6px;">Ni perfume ni aceites esenciales</span></div>
          <div style="background:var(--color-accent2-100);border-radius:20px;padding:18px 20px;"><span style="display:block;font-size:12px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--color-accent2-700);">Sin alcohol denat.</span><span style="display:block;font-size:14.5px;color:var(--color-neutral-900);margin-top:6px;">Apto en piel reactiva</span></div>
          <div style="background:var(--color-neutral-200);border-radius:20px;padding:18px 20px;"><span style="display:block;font-size:12px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--color-neutral-700);">15 ingredientes</span><span style="display:block;font-size:14.5px;color:var(--color-neutral-900);margin-top:6px;">Fórmula corta, fácil de auditar</span></div>
        </div>
      </div>
      <div>
        <h2 style="font-family:var(--font-heading);font-size:30px;letter-spacing:-.02em;margin:0 0 8px;">Lo que hemos escrito sobre esto</h2>
        <p style="font-size:15px;line-height:1.65;color:var(--color-neutral-700);margin:0 0 24px;max-width:44ch;">Artículos del diario donde este producto o su activo principal aparecen.</p>
        <div style="display:flex;flex-direction:column;gap:2px;">
          {[
            { cat: 'Activos', title: 'Niacinamida: el rango que sí tiene respaldo', date: '11 de agosto · 8 min' },
            { cat: 'Mitos', title: 'Niacinamida y vitamina C: por qué esa incompatibilidad no existe', date: '28 de julio · 6 min' },
            { cat: 'Rutinas', title: 'Ocho semanas con este sérum: el diario de la prueba', date: '20 de julio · 11 min' },
            { cat: 'Barrera', title: 'Cuando la piel no está seca, está agrietada', date: '14 de agosto · 9 min' },
          ].map(post => (
            <a href="/diario/" style="display:grid;grid-template-columns:96px 1fr;gap:18px;align-items:center;padding:18px 0;border-bottom:1px solid var(--color-divider);color:var(--color-text);text-decoration:none;">
              <figure class="washed" style="margin:0;border-radius:16px;overflow:hidden;background:var(--color-surface);width:96px;height:76px;display:grid;place-content:center;"><span style="font-size:10px;color:var(--color-neutral-600);">Foto</span></figure>
              <div>
                <span style="font-size:12px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--color-accent-700);">{post.cat}</span>
                <strong style="display:block;font-family:var(--font-heading);font-weight:400;font-size:18px;line-height:1.25;margin:4px 0 4px;">{post.title}</strong>
                <span style="font-size:13px;color:var(--color-neutral-700);">{post.date}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
    
    <div style="padding:76px 56px 64px;max-width:1280px;margin:0 auto;">
      <h2 style="font-family:var(--font-heading);font-size:30px;letter-spacing:-.02em;margin:0 0 26px;">Alternativas que también pasan el corte</h2>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;">
        {[
          { title: 'Gel de niacinamida 4%', price: 'Más ligero · 14 €' },
          { title: 'Crema con ceramidas', price: 'Para piel seca · 21 €' },
          { title: 'Sérum de azelaico 10%', price: 'Si hay rojez · 19 €' },
        ].map(alt => (
          <a href="#" style="display:flex;gap:18px;align-items:center;background:var(--color-neutral-100);border-radius:24px;padding:20px;color:var(--color-text);text-decoration:none;">
            <figure class="washed" style="margin:0;border-radius:16px;overflow:hidden;background:var(--color-surface);width:84px;height:84px;display:grid;place-content:center;flex:none;"><span style="font-size:10px;color:var(--color-neutral-600);">Alt</span></figure>
            <div><strong style="font-weight:600;font-size:15.5px;display:block;">{alt.title}</strong><span style="font-size:14px;color:var(--color-neutral-700);">{alt.price}</span></div>
          </a>
        ))}
      </div>
    </div>
    
    <Footer />
  </div>
</Layout>
