---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import data from '../../data/productos-categorias.json';
---

<Layout title="Categorías de productos — Bellezaypiel" description="Explora las categorías de productos revisados: limpiadores, sérums, hidratantes, solares y más.">
  <div style="background:var(--color-bg);min-height:100vh;">
    <Header active="productos" />

    <div style="position:relative;padding:52px 56px 0;overflow:hidden;max-width:1280px;margin:0 auto;">
      <div style="position:absolute;right:-90px;top:-120px;width:300px;height:300px;border-radius:50%;background:var(--color-accent2-200);opacity:.7;"></div>
      <div style="position:relative;display:flex;gap:8px;font-size:13.5px;color:var(--color-neutral-700);margin-bottom:20px;">
        <a href="/" style="color:var(--color-neutral-700);">Inicio</a><span>/</span><span style="font-weight:600;color:var(--color-text);">Productos</span>
      </div>
      <h1 style="position:relative;font-family:var(--font-heading);font-size:52px;line-height:1.08;letter-spacing:-.028em;margin:0;max-width:20ch;">Categorías de productos</h1>
      <p style="position:relative;font-size:17px;line-height:1.7;color:#3a3733;margin:22px 0 0;max-width:58ch;">{data.categorias.length} categorías revisadas con el mismo criterio: ocho semanas de uso, fórmula leída ingrediente a ingrediente y veredicto sin presiones comerciales.</p>
    </div>

    <div style="padding:48px 56px 64px;max-width:1280px;margin:0 auto;display:grid;grid-template-columns:repeat(3,1fr);gap:26px;">
      {data.categorias.map((cat, idx) => (
        <a href={`/productos/${cat.slug}/`} style={`display:flex;flex-direction:column;gap:12px;background:${idx % 2 === 0 ? 'var(--color-neutral-100)' : 'var(--color-accent2-100)'};border-radius:26px;padding:28px;color:var(--color-text);text-decoration:none;`}>
          <h3 style="font-family:var(--font-heading);font-weight:400;font-size:22px;margin:0;">{cat.nombre}</h3>
          <p style="font-size:14.5px;line-height:1.6;color:#4a463f;margin:0;">{cat.descripcion}</p>
        </a>
      ))}
    </div>

    <Footer />
  </div>
</Layout>
